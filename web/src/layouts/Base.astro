---
const { title = '汉为软件', description = '厦门汉为软件技术有限公司' } = Astro.props;
const nav = [
  { href: '/', label: '首页' },
  { href: '/news/', label: '新闻动态' },
  { href: '/cases/', label: '客户案例' },
  { href: '/about/', label: '关于我们' },
  { href: '/contact/', label: '联系我们' },
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title === '汉为软件' ? title : `${title} | 汉为软件`}</title>
  <meta name="description" content={description} />
  <link rel="sitemap" href="/sitemap-index.xml" />
</head>
<body>
  <header class="site-header">
    <div class="wrap bar">
      <a href="/" class="logo">汉为软件</a>
      <nav>
        {nav.map(n => <a href={n.href} class={(n.href === '/' ? path === '/' : path.startsWith(n.href)) ? 'on' : ''}>{n.label}</a>)}
      </nav>
    </div>
  </header>
  <main><slot /></main>
  <footer class="site-footer">
    <div class="wrap">© {new Date().getFullYear()} 厦门汉为软件技术有限公司</div>
  </footer>
</body>
</html>
<style is:global>
  *{box-sizing:border-box} body{margin:0;font-family:-apple-system,"PingFang SC","Microsoft YaHei",sans-serif;color:#1f2937;line-height:1.7;background:#fff}
  a{color:#0b5cad;text-decoration:none} a:hover{text-decoration:underline}
  .wrap{max-width:1120px;margin:0 auto;padding:0 20px}
  .site-header{border-bottom:1px solid #e5e7eb;position:sticky;top:0;background:#fff;z-index:10}
  .bar{display:flex;justify-content:space-between;align-items:center;height:64px}
  .logo{font-size:20px;font-weight:700;color:#0b5cad}
  nav a{margin-left:24px;color:#374151} nav a.on{color:#0b5cad;font-weight:600}
  main{min-height:70vh;padding:40px 0}
  .site-footer{border-top:1px solid #e5e7eb;padding:24px 0;color:#6b7280;font-size:14px}
  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:24px}
  .card{border:1px solid #e5e7eb;border-radius:10px;overflow:hidden;background:#fff;transition:box-shadow .2s}
  .card:hover{box-shadow:0 6px 20px rgba(0,0,0,.08)} .card img{width:100%;height:180px;object-fit:cover;display:block}
  .card .c{padding:16px} .card h3{margin:0 0 8px;font-size:18px;color:#111827} .meta{color:#6b7280;font-size:13px}
  .prose{max-width:760px} .prose img{max-width:100%;border-radius:8px;margin:16px 0}
  .hero{background:linear-gradient(135deg,#0b5cad,#1e88e5);color:#fff;padding:80px 0;margin:-40px 0 40px}
  .hero h1{font-size:40px;margin:0 0 12px} .hero p{font-size:18px;opacity:.9;margin:0}
  h2.sec{font-size:26px;margin:40px 0 20px}
</style>
